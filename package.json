{
  "name": "auto-review",
  "version": "0.2.4",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/unit/",
    "check": "node tests/check-syntax.mjs",
    "smoke": "node tests/smoke.mjs",
    "pack": "rm -rf dist && electron-builder --mac --arm64 && mkdir -p dmgs && rm -f dmgs/*.dmg && cp dist/*.dmg dmgs/"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.0.12",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.yjq.autoreview",
    "productName": "ReviewFlow",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
